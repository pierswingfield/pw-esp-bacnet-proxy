# WiFi provisioning / captive portal config (dns_server + http server both
# need more sockets than the default for the DNS redirect + form handling).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16

# Two-OTA-slot table (partitions.csv) for LAN firmware updates - see
# api_ota_post_handler in main.c. Replaces the single-app-large table used
# while there was no OTA path; two 1900K slots comfortably clear the
# ~1.15MB image (MQTT/TLS footprint and all) with room to grow.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bootloader-level safety net for the OTA path: a newly-flashed image boots
# in "pending verify" state, and if it crashes/WDT-resets before main.c
# calls esp_ota_mark_app_valid_cancel_rollback(), the bootloader
# automatically reboots into the previous slot instead of crash-looping.
# This is the difference between a bad OTA push needing a truck roll (unit
# is going in the wall) and it silently self-healing.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Broker (mosquitto on the Pi, allow_anonymous, LAN-only) is plain TCP -
# drop SSL/WSS transport support esp-mqtt links by default, we never use it.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n

# Panic backtrace to flash - the board runs headless, so a crash previously
# left nothing but a reset reason. Needs the `coredump` partition.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32

# sys_evt overflowed its 2304-byte stack on 2026-08-23 mid-way through a
# diag_log() call in the WiFi disconnect handler (log line truncated at "DIA").
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
