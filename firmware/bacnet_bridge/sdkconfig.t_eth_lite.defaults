# Hardware profile: original LILYGO T-ETH-Lite ESP32-WROVER-E + RTL8201.
# Use with a separate SDKCONFIG/build directory; see docs/T_ETH_LITE_V2_ARCHITECTURE_AND_BUILD.md.
CONFIG_EXAMPLE_USE_INTERNAL_ETHERNET=y
CONFIG_EXAMPLE_USE_SPI_ETHERNET=n
# CONFIG_EXAMPLE_USE_W5500 is not set
CONFIG_EXAMPLE_ETH_PHY_RTL8201=y
CONFIG_EXAMPLE_ETH_MDC_GPIO=23
CONFIG_EXAMPLE_ETH_MDIO_GPIO=18
CONFIG_EXAMPLE_ETH_PHY_RST_GPIO=-1
CONFIG_EXAMPLE_ETH_PHY_POWER_GPIO=12
CONFIG_EXAMPLE_ETH_PHY_ADDR=0

CONFIG_ETH_RMII_CLK_INPUT=y
# CONFIG_ETH_RMII_CLK_OUTPUT is not set
CONFIG_ETH_RMII_CLK_IN_GPIO=0

# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_t_eth_lite.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
# Let ordinary allocations larger than 16 KiB use the WROVER-E's PSRAM while
# retaining task stacks and DMA/internal-only allocations in internal RAM.
# CONFIG_SPIRAM_USE_CAPS_ALLOC is not set
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Live full-parity startup proved the 32 KiB HTTP task plus configured MQTT
# tasks cannot coexist if Wi-Fi/LwIP buffers also consume internal DRAM. These
# ESP-IDF-managed buffers are PSRAM-aware; their allocations fall back to
# internal memory if external allocation fails.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# The optional object-discovery worker uses a short-lived PSRAM stack, keeping
# 24 KiB of internal DRAM available to the BACnet/HTTP control path.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MEMTEST=y

# Enable Matter-over-Wi-Fi Thermostat Endpoint support for T-ETH-Lite (16MB Flash, 8MB PSRAM)
CONFIG_ENABLE_ESP_MATTER=y
