#!/usr/bin/env python3
"""UDP debug log listener for the esp-bacnet bridge (port 5514).
Fire-and-forget lines from the device's diag_log(); appends timestamped
lines to esp-bacnet-diag.log, rotating to .1 once the file passes 10MB."""
import datetime
import os
import socket

BIND_IP = "192.168.1.8"
BIND_PORT = 5514
LOG_PATH = "/home/pi/esp-bacnet-diag/esp-bacnet-diag.log"
MAX_BYTES = 10 * 1024 * 1024

def rotate_if_needed():
    try:
        if os.path.getsize(LOG_PATH) > MAX_BYTES:
            os.replace(LOG_PATH, LOG_PATH + ".1")
    except FileNotFoundError:
        pass

def main():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind((BIND_IP, BIND_PORT))
    print(f"listening on {BIND_IP}:{BIND_PORT}, logging to {LOG_PATH}", flush=True)
    while True:
        data, addr = sock.recvfrom(2048)
        line = data.decode("utf-8", errors="replace").rstrip("\n")
        ts = datetime.datetime.now().isoformat(timespec="seconds")
        rotate_if_needed()
        with open(LOG_PATH, "a") as f:
            f.write(f"{ts} {addr[0]} {line}\n")

if __name__ == "__main__":
    main()
