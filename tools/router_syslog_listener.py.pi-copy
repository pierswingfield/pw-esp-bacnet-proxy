#!/usr/bin/env python3
"""Minimal syslog (RFC3164-ish, UDP) listener for the Asus router - raw text
append, no parsing. Correlate with esp-bacnet-diag.log by timestamp."""
import datetime
import os
import socket

BIND_IP = "192.168.1.8"
BIND_PORT = 5140
LOG_PATH = "/home/pi/esp-bacnet-diag/router-syslog.log"
MAX_BYTES = 20 * 1024 * 1024

def rotate_if_needed():
    try:
        if os.path.getsize(LOG_PATH) > MAX_BYTES:
            os.replace(LOG_PATH, LOG_PATH + ".1")
    except FileNotFoundError:
        pass

def main():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind((BIND_IP, BIND_PORT))
    print(f"listening on {BIND_IP}:{BIND_PORT}, logging to {LOG_PATH}", flush=True)
    while True:
        data, addr = sock.recvfrom(4096)
        line = data.decode("utf-8", errors="replace").rstrip("\n")
        ts = datetime.datetime.now().isoformat(timespec="seconds")
        rotate_if_needed()
        with open(LOG_PATH, "a") as f:
            f.write(f"{ts} [{addr[0]}] {line}\n")

if __name__ == "__main__":
    main()
